@using System.ComponentModel.DataAnnotations
@inject ApiClient Api

<div class="card app-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Contacts</span>
        <button type="button" class="btn btn-sm btn-primary" @onclick="OpenCreate">Add contact</button>
    </div>
    <div class="card-body">
        @if (_loading)
        {
            <span class="text-muted" role="status">Loading contacts...</span>
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <span class="text-danger">@_error</span>
        }
        else if (_contacts.Count == 0)
        {
            <span class="text-muted">No contacts yet.</span>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var contact in _contacts)
                {
                    <li class="list-group-item px-0">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <div class="fw-semibold">@(contact.Name ?? "Unnamed contact")</div>
                                @if (!string.IsNullOrWhiteSpace(contact.Role))
                                {
                                    <div class="small text-muted">@contact.Role</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(contact.Email) || !string.IsNullOrWhiteSpace(contact.Phone))
                                {
                                    <div class="small">
                                        @if (!string.IsNullOrWhiteSpace(contact.Email))
                                        {
                                            <a href="mailto:@contact.Email">@contact.Email</a>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(contact.Email) && !string.IsNullOrWhiteSpace(contact.Phone))
                                        {
                                            <span aria-hidden="true">&middot;</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(contact.Phone))
                                        {
                                            <span>@contact.Phone</span>
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(contact.Notes))
                                {
                                    <p class="mb-0 small text-break mt-1">@contact.Notes</p>
                                }
                            </div>
                            <div class="text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEdit(contact)">Edit</button>
                                @if (_deleteId == contact.Id)
                                {
                                    <span class="text-danger ms-2">Delete this contact?</span>
                                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => ConfirmDeleteAsync(contact.Id)">Delete</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelDelete">Cancel</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => StartDelete(contact.Id)">Delete</button>
                                }
                            </div>
                        </div>
                    </li>
                }
            </ul>
        }
        @if (!string.IsNullOrEmpty(_deleteError))
        {
            <div class="alert alert-danger mt-3" role="alert">@_deleteError</div>
        }
    </div>
</div>

@if (_dialogOpen)
{
    <div class="modal fade show" style="display:block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <EditForm Model="_form" OnValidSubmit="SaveAsync" FormName="contact-form">
                    <DataAnnotationsValidator />
                    <CascadingValue Value="@(_serverErrors ?? NoErrors)" TValue="IReadOnlyDictionary<string, string[]>">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5">@(_editingId is null ? "Add contact" : "Edit contact")</h1>
                            <button type="button" class="btn-close" aria-label="Close" @onclick="CloseDialog"></button>
                        </div>
                        <div class="modal-body">
                            @if (!string.IsNullOrEmpty(_dialogError))
                            {
                                <div class="alert alert-danger" role="alert">@_dialogError</div>
                            }
                            <div class="mb-3">
                                <label for="dialog-contact-name" class="form-label">Name</label>
                                <InputText id="dialog-contact-name" class="form-control" @bind-Value="_form.Name" />
                                <ValidationMessage For="() => _form.Name" />
                                <ServerValidationMessage Field="Name" />
                            </div>
                            <div class="mb-3">
                                <label for="dialog-contact-role" class="form-label">Role</label>
                                <InputText id="dialog-contact-role" class="form-control" @bind-Value="_form.Role" />
                                <ValidationMessage For="() => _form.Role" />
                                <ServerValidationMessage Field="Role" />
                            </div>
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label for="dialog-contact-email" class="form-label">Email</label>
                                    <InputText id="dialog-contact-email" class="form-control" @bind-Value="_form.Email" />
                                    <ValidationMessage For="() => _form.Email" />
                                    <ServerValidationMessage Field="Email" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label for="dialog-contact-phone" class="form-label">Phone</label>
                                    <InputText id="dialog-contact-phone" class="form-control" @bind-Value="_form.Phone" />
                                    <ValidationMessage For="() => _form.Phone" />
                                    <ServerValidationMessage Field="Phone" />
                                </div>
                            </div>
                            <div class="mt-3">
                                <label for="dialog-contact-notes" class="form-label">Notes</label>
                                <InputTextArea id="dialog-contact-notes" class="form-control" rows="3" @bind-Value="_form.Notes" />
                                <ValidationMessage For="() => _form.Notes" />
                                <ServerValidationMessage Field="Notes" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" @onclick="CloseDialog">Cancel</button>
                            <button type="submit" class="btn btn-primary" disabled="@_saving">
                                @(_saving ? "Saving..." : (_editingId is null ? "Add contact" : "Save changes"))
                            </button>
                        </div>
                    </CascadingValue>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop"></div>
}

@code {
    [Parameter, EditorRequired] public required Guid ApplicationId { get; set; }

    private static readonly IReadOnlyDictionary<string, string[]> NoErrors = new Dictionary<string, string[]>();

    private List<ContactResponse> _contacts = [];
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private string? _deleteError;
    private string? _dialogError;
    private IReadOnlyDictionary<string, string[]>? _serverErrors;
    private Guid? _editingId;
    private Guid? _deleteId;
    private bool _dialogOpen;
    private ContactFormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _contacts = await Api.GetAsync<List<ContactResponse>>($"applications/{ApplicationId}/contacts");
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenCreate()
    {
        _editingId = null;
        _form = new ContactFormModel();
        _dialogError = null;
        _serverErrors = null;
        _dialogOpen = true;
    }

    private void OpenEdit(ContactResponse contact)
    {
        _editingId = contact.Id;
        _form = new ContactFormModel
        {
            Name = contact.Name,
            Email = contact.Email,
            Phone = contact.Phone,
            Role = contact.Role,
            Notes = contact.Notes,
        };
        _dialogError = null;
        _serverErrors = null;
        _dialogOpen = true;
    }

    private void CloseDialog()
    {
        _dialogOpen = false;
        _saving = false;
        _dialogError = null;
        _serverErrors = null;
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        _dialogError = null;
        _serverErrors = null;
        try
        {
            var request = ToRequest();
            if (_editingId is null)
            {
                await Api.PostAsync<ContactResponse>(
                    $"applications/{ApplicationId}/contacts", request);
            }
            else
            {
                await Api.PutAsync(
                    $"applications/{ApplicationId}/contacts/{_editingId}", request);
            }

            CloseDialog();
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _serverErrors = ex.Errors is { Count: > 0 } ? ex.Errors : null;
            _dialogError = _serverErrors is null ? ex.Message : null;
        }
        finally
        {
            _saving = false;
        }
    }

    private ContactRequest ToRequest() => new(
        string.IsNullOrWhiteSpace(_form.Name) ? null : _form.Name.Trim(),
        string.IsNullOrWhiteSpace(_form.Email) ? null : _form.Email.Trim(),
        string.IsNullOrWhiteSpace(_form.Phone) ? null : _form.Phone.Trim(),
        string.IsNullOrWhiteSpace(_form.Role) ? null : _form.Role.Trim(),
        string.IsNullOrWhiteSpace(_form.Notes) ? null : _form.Notes.Trim());

    private void StartDelete(Guid id)
    {
        _deleteId = id;
        _deleteError = null;
    }

    private void CancelDelete()
    {
        _deleteId = null;
        _deleteError = null;
    }

    private async Task ConfirmDeleteAsync(Guid id)
    {
        try
        {
            await Api.DeleteAsync($"applications/{ApplicationId}/contacts/{id}");
            _deleteId = null;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _deleteError = ex.Message;
            _deleteId = null;
        }
    }

    private sealed class ContactFormModel
    {
        [StringLength(200, ErrorMessage = "Name cannot be longer than 200 characters.")]
        public string? Name { get; set; }

        [StringLength(256, ErrorMessage = "Email cannot be longer than 256 characters.")]
        public string? Email { get; set; }

        [StringLength(50, ErrorMessage = "Phone cannot be longer than 50 characters.")]
        public string? Phone { get; set; }

        [StringLength(200, ErrorMessage = "Role cannot be longer than 200 characters.")]
        public string? Role { get; set; }

        public string? Notes { get; set; }
    }
}
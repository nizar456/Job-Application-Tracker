@if (ServerErrors is not null && ServerErrors.TryGetValue(Field, out var messages))
{
    @foreach (var message in messages)
    {
        <div class="validation-message mt-1">@message</div>
    }
}

@code {
    [CascadingParameter] public IReadOnlyDictionary<string, string[]>? ServerErrors { get; set; }

    [Parameter, EditorRequired]
    public required string Field { get; set; }
}
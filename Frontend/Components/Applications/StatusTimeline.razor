@foreach (var entry in History)
{
    <div class="timeline-item">
        <div class="timeline-dot" aria-hidden="true"></div>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="badge @entry.Status.BadgeClass()">@entry.Status.DisplayName()</span>
            <span class="small text-muted text-nowrap">@entry.ChangedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
        </div>
        @if (!string.IsNullOrEmpty(entry.Note))
        {
            <p class="mb-0 text-break mt-1">@entry.Note</p>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public required IReadOnlyList<StatusHistoryResponse> History { get; set; }
}
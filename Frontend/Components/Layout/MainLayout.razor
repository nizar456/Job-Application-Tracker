@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar" aria-label="Application sidebar">
        <input type="checkbox" id="sidebar-toggle" class="sidebar-toggle-input" title="Toggle navigation menu" aria-label="Toggle navigation menu" />
        <label for="sidebar-toggle" class="sidebar-backdrop" aria-hidden="true"></label>
        <div class="sidebar-drawer">
            <div class="sidebar-header">
                <a class="brand" href="/">
                    <span class="brand-icon" aria-hidden="true">
                        <svg viewBox="0 0 16 16" fill="currentColor"><path d="M4 1.5H3a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5V2a.5.5 0 0 0-.5-.5Zm2.5 0V2a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-.5a.5.5 0 0 0-.5-.5H7a.5.5 0 0 0-.5.5ZM3 5a.5.5 0 0 0 0 1h10a.5.5 0 0 0 0-1H3Zm0 3a.5.5 0 0 0 0 1h10a.5.5 0 0 0 0-1H3Zm0 3a.5.5 0 0 0 0 1h4a.5.5 0 0 0 0-1H3Z"/></svg>
                    </span>
                    <span class="brand-name">Job Tracker</span>
                </a>
            </div>
            <nav class="sidebar-nav" aria-label="Main navigation">
                <div class="nav-group">
                    <div class="nav-group-title">Workspace</div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="dashboard">
                            <svg class="nav-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M0 8a8 8 0 1 1 15.909 2.532l-.01.025-.013.03c-.04.088-.1.2-.162.32a29.99 29.99 0 0 1-.94 1.646c-.38.6-1.095 1.447-2.366 1.447h-7.84c-1.27 0-1.985-.847-2.366-1.447a30.003 30.003 0 0 1-.94-1.646l-.013-.03-.01-.025A7.993 7.993 0 0 1 0 8Zm8-7a7 7 0 0 0-6.932 7.29c.13.542.343.98.598 1.316.25.325.509.394.834.394h5c.325 0 .584-.069.834-.394.255-.335.468-.774.598-1.315A7 7 0 0 0 8 1Zm-2.5 4.5a.5.5 0 0 1 .707 0l.982.982a1.707 1.707 0 1 1-.707.707L5.5 6.207a.5.5 0 0 1 0-.707ZM8 4a.5.5 0 0 1 .5.5V5a.5.5 0 0 1-1 0v-.5A.5.5 0 0 1 8 4Z"/></svg>
                            <span>Dashboard</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="applications">
                            <svg class="nav-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M3 4.5a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1Zm0 3a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1Zm0 3a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1Zm8 0a.5.5 0 0 1 .5-.5H13a.5.5 0 0 1 0 1h-1.5a.5.5 0 0 1-.5-.5Zm0-3a.5.5 0 0 1 .5-.5H13a.5.5 0 0 1 0 1h-1.5a.5.5 0 0 1-.5-.5Zm0-3a.5.5 0 0 1 .5-.5H13a.5.5 0 0 1 0 1h-1.5a.5.5 0 0 1-.5-.5ZM3.5 6a.5.5 0 0 0 0 1h2a.5.5 0 0 0 0-1h-2Zm0 3a.5.5 0 0 0 0 1h2a.5.5 0 0 0 0-1h-2Zm0-6a.5.5 0 0 0 0 1h2a.5.5 0 0 0 0-1h-2Z"/></svg>
                            <span>Applications</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="applications/create">
                            <svg class="nav-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2Zm6.5 4.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3a.5.5 0 0 1 1 0Z"/></svg>
                            <span>New application</span>
                        </NavLink>
                    </div>
                </div>
                <div class="nav-group">
                    <div class="nav-group-title">Manage</div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="companies">
                            <svg class="nav-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M2 1a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V1Zm10 0H4v14h8V1Zm-8.5 1a.5.5 0 0 0 0 1h1a.5.5 0 0 0 0-1h-1Zm0 3a.5.5 0 0 0 0 1h1a.5.5 0 0 0 0-1h-1Zm0 3a.5.5 0 0 0 0 1h1a.5.5 0 0 0 0-1h-1Zm0 3a.5.5 0 0 0 0 1h1a.5.5 0 0 0 0-1h-1Zm3-9a.5.5 0 0 0 0 1h1a.5.5 0 0 0 0-1h-1Zm0 3a.5.5 0 0 0 0 1h1a.5.5 0 0 0 0-1h-1Zm0 3a.5.5 0 0 0 0 1h1a.5.5 0 0 0 0-1h-1Zm0 3a.5.5 0 0 0 0 1h1a.5.5 0 0 0 0-1h-1Zm3-9a.5.5 0 0 0 0 1h1a.5.5 0 0 0 0-1h-1Zm0 3a.5.5 0 0 0 0 1h1a.5.5 0 0 0 0-1h-1Zm0 3a.5.5 0 0 0 0 1h1a.5.5 0 0 0 0-1h-1Zm0 3a.5.5 0 0 0 0 1h1a.5.5 0 0 0 0-1h-1Z"/></svg>
                            <span>Companies</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="resume-versions">
                            <svg class="nav-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5Zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h-2ZM5.5 2.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1H6a.5.5 0 0 1-.5-.5Zm0 2a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1H6a.5.5 0 0 1-.5-.5Zm.5 2.5a.5.5 0 0 0 0 1h4a.5.5 0 0 0 0-1H6Zm0 2a.5.5 0 0 0 0 1h4a.5.5 0 0 0 0-1H6Zm0 2a.5.5 0 0 0 0 1h4a.5.5 0 0 0 0-1H6Z"/></svg>
                            <span>CV versions</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="tags">
                            <svg class="nav-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M3 2v4.586l7 7L14.586 9 7.586 2H3Zm.5-1h4.086a1 1 0 0 1 .707.293l7 7a1 1 0 0 1 0 1.414l-4.586 4.586a1 1 0 0 1-1.414 0l-7-7A1 1 0 0 1 2 6.586V2.5A.5.5 0 0 1 2.5 1ZM5.5 6a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"/></svg>
                            <span>Tags</span>
                        </NavLink>
                    </div>
                </div>
            </nav>
            <div class="sidebar-footer">
                <AuthorizeView>
                    <Authorized context="state">
                        <div class="sidebar-user">
                            <span class="sidebar-avatar" aria-hidden="true">@Initials(state.User.Identity?.Name)</span>
                            <span class="sidebar-user-name">@state.User.Identity?.Name</span>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
    </aside>

    <div class="app-main">
        <header class="topbar">
            <div class="topbar-context"><CurrentPageTitle /></div>
            <div class="topbar-actions">
                <AuthorizeView>
                    <Authorized context="state">
                        <span class="topbar-user">
                            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4Z"/></svg>
                            <span>@state.User.Identity?.Name</span>
                        </span>
                        <a class="btn btn-outline-secondary btn-sm" href="account">Account</a>
                        <a class="btn btn-outline-danger btn-sm" href="logout">Sign out</a>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-outline-primary btn-sm" href="login">Sign in</a>
                        <a class="btn btn-primary btn-sm" href="register">Register</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="content">
            <article class="content-inner">
                @Body
            </article>
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        return string.Join(string.Empty, name
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => part[0]));
    }
}

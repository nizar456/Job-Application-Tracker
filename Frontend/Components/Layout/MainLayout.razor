@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar" aria-label="Application sidebar">
        <input type="checkbox" id="sidebar-toggle" class="sidebar-toggle-input" title="Toggle navigation menu" aria-label="Toggle navigation menu" />
        <label for="sidebar-toggle" class="sidebar-backdrop" aria-hidden="true"></label>
        <div class="sidebar-drawer">
            <div class="sidebar-header">
                <a class="brand" href="/">
                    <span class="brand-icon" aria-hidden="true">
                        <i class="bi bi-clipboard-data"></i>
                    </span>
                    <span class="brand-name">Job Tracker</span>
                </a>
            </div>
            <nav class="sidebar-nav" aria-label="Main navigation">
                <div class="nav-group">
                    <div class="nav-group-title">Workspace</div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="dashboard">
                            <i class="bi bi-speedometer2 nav-icon" aria-hidden="true"></i>
                            <span>Dashboard</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="applications">
                            <i class="bi bi-list-ul nav-icon" aria-hidden="true"></i>
                            <span>Applications</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="applications/create">
                            <i class="bi bi-plus-square nav-icon" aria-hidden="true"></i>
                            <span>New application</span>
                        </NavLink>
                    </div>
                </div>
                <div class="nav-group">
                    <div class="nav-group-title">Manage</div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="companies">
                            <i class="bi bi-building nav-icon" aria-hidden="true"></i>
                            <span>Companies</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="resume-versions">
                            <i class="bi bi-file-earmark-text nav-icon" aria-hidden="true"></i>
                            <span>CV versions</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="tags">
                            <i class="bi bi-tags nav-icon" aria-hidden="true"></i>
                            <span>Tags</span>
                        </NavLink>
                    </div>
                </div>
            </nav>
            <div class="sidebar-footer">
                <AuthorizeView>
                    <Authorized context="state">
                        <div class="sidebar-user">
                            <span class="sidebar-avatar" aria-hidden="true">@Initials(state.User.Identity?.Name)</span>
                            <span class="sidebar-user-name">@state.User.Identity?.Name</span>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
    </aside>

    <div class="app-main">
        <header class="topbar">
            <div class="topbar-context"><CurrentPageTitle /></div>
            <div class="topbar-actions">
                <AuthorizeView>
                    <Authorized context="state">
                        <span class="topbar-user">
                            <i class="bi bi-person-circle" aria-hidden="true"></i>
                            <span>@state.User.Identity?.Name</span>
                        </span>
                        <a class="btn btn-outline-secondary btn-sm" href="account">Account</a>
                        <a class="btn btn-outline-danger btn-sm" href="logout">Sign out</a>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-outline-primary btn-sm" href="login">Sign in</a>
                        <a class="btn btn-primary btn-sm" href="register">Register</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="content">
            <article class="content-inner">
                @Body
            </article>
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        return string.Join(string.Empty, name
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => part[0]));
    }
}

@page "/logout"
@attribute [Authorize]
@inject ApiAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Sign out</PageTitle>

<div class="auth-card mx-auto">
    <h1>Sign out</h1>
    <p class="page-subtitle">Are you sure you want to sign out?</p>

    <div class="d-flex gap-2">
        <button class="btn btn-primary" @onclick="HandleLogoutAsync" disabled="@_busy">Sign out</button>
        <a class="btn btn-outline-secondary" href="/">Cancel</a>
    </div>
</div>

@code {
    private bool _busy;

    private async Task HandleLogoutAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        await AuthenticationStateProvider.SignOutAsync();
        Navigation.NavigateTo("/", replace: true);
    }
}

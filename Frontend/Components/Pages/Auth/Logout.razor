@page "/logout"
@attribute [Authorize]
@inject ApiAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Sign out</PageTitle>

<h1>Sign out</h1>

<p>Are you sure you want to sign out?</p>

<button class="btn btn-primary" @onclick="HandleLogoutAsync" disabled="@_busy">Sign out</button>
<a class="btn btn-link" href="/">Cancel</a>

@code {
    private bool _busy;

    private void HandleLogoutAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        AuthenticationStateProvider.SignOut();
        Navigation.NavigateTo("/", replace: true);
    }
}
@page "/register"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@inject AuthClient AuthClient
@inject ApiAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ILogger<Register> Logger
@inject IJSRuntime Js

<PageTitle>Register</PageTitle>

<h1>Create your account</h1>
<p class="auth-subtitle">Start tracking your job applications today.</p>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

<EditForm Model="@_model" OnValidSubmit="HandleRegisterAsync" OnInvalidSubmit="HandleInvalidSubmit" FormName="register">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label for="register-username" class="form-label">User name</label>
        <InputText id="register-username" class="form-control" @bind-Value="_model.UserName" autocomplete="username" />
        <ValidationMessage For="() => _model.UserName" />
    </div>
    <div class="mb-3">
        <label for="register-email" class="form-label">Email</label>
        <InputText id="register-email" class="form-control" @bind-Value="_model.Email" autocomplete="email" />
        <ValidationMessage For="() => _model.Email" />
    </div>
    <div class="mb-3">
        <label for="register-password" class="form-label">Password</label>
        <span class="form-text d-block mb-1">At least 8 characters with upper and lower case, a number, and a symbol.</span>
        <InputText id="register-password" class="form-control" type="password" @bind-Value="_model.Password" autocomplete="new-password" />
        <ValidationMessage For="() => _model.Password" />
    </div>
    <div class="mb-3">
        <label for="register-confirm" class="form-label">Confirm password</label>
        <InputText id="register-confirm" class="form-control" type="password" @bind-Value="_model.ConfirmPassword" autocomplete="new-password" />
        <ValidationMessage For="() => _model.ConfirmPassword" />
    </div>
    <button type="submit" class="btn btn-primary w-100" disabled="@_busy">@(_busy ? "Creating account..." : "Create account")</button>
</EditForm>

<p class="mt-3 mb-0 text-center">
    Already have an account? <a href="login">Sign in</a>
</p>

@code {
    private readonly RegisterForm _model = new();
    private bool _busy;
    private string? _error;

    private void HandleInvalidSubmit(EditContext editContext)
    {
        var errors = editContext.GetValidationMessages().ToList();
        Logger.LogWarning(
            "Registration form rejected on the client: {Errors}", string.Join("; ", errors));
        _error = string.Join(" ", errors);
    }

    private async Task HandleRegisterAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        Logger.LogInformation(
            "Registration submitted for user {UserName} (email {Email}).",
            _model.UserName, _model.Email);
        try
        {
            var auth = await AuthClient.RegisterAsync(new RegisterRequest(_model.UserName!, _model.Email!, _model.Password!));
            Logger.LogInformation(
                "Registration succeeded for user {UserName} (email {Email}); token expires {ExpiresAt:O}.",
                auth.UserName, _model.Email, auth.ExpiresAt);
            await AuthenticationStateProvider.SignInAsync(auth);
            Logger.LogInformation("Navigating to home after registration.");
            Navigation.NavigateTo("/", replace: true);
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(
                "Registration failed for email {Email}: {Message} (status {StatusCode}, errors {Errors}).",
                _model.Email, ex.Message, ex.StatusCode, ex.Errors);
            await Js.InvokeVoidAsync("console.warn",
                $"Registration failed: {ex.Message} (status {ex.StatusCode}, errors {string.Join("; ", ex.Errors?.Values.SelectMany(v => v) ?? [])})");
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex, "Unexpected error during registration for email {Email}.", _model.Email);
            await Js.InvokeVoidAsync("console.error", $"Registration unexpected error: {ex}");
            _error = "Something went wrong during registration. Please try again.";
        }
        finally
        {
            _busy = false;
            Logger.LogInformation("Registration handler finished.");
        }
    }

    private sealed class RegisterForm
    {
        [Required, StringLength(50, MinimumLength = 3)]
        public string? UserName { get; set; }

        [Required, EmailAddress]
        public string? Email { get; set; }

        [Required, StringLength(100, MinimumLength = 8)]
        public string? Password { get; set; }

        [Required, Compare(nameof(Password))]
        public string? ConfirmPassword { get; set; }
    }
}
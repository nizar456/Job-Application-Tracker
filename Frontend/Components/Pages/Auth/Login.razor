@page "/login"
@using System.ComponentModel.DataAnnotations
@inject AuthClient AuthClient
@inject ApiAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Sign in</PageTitle>

<h1>Sign in</h1>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

<EditForm Model="@_model" OnValidSubmit="HandleLoginAsync" FormName="login">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label for="login-email" class="form-label">Email</label>
        <InputText id="login-email" class="form-control" @bind-Value="_model.Email" autocomplete="username" />
    </div>
    <div class="mb-3">
        <label for="login-password" class="form-label">Password</label>
        <InputText id="login-password" class="form-control" type="password" @bind-Value="_model.Password" autocomplete="current-password" />
    </div>
    <button type="submit" class="btn btn-primary" disabled="@_busy">@(_busy ? "Signing in..." : "Sign in")</button>
</EditForm>

<p class="mt-3">
    Don't have an account? <a href="register">Register</a>
</p>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private readonly LoginForm _model = new();
    private bool _busy;
    private string? _error;

    private async Task HandleLoginAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var auth = await AuthClient.LoginAsync(new LoginRequest(_model.Email!, _model.Password!));
            AuthenticationStateProvider.SignIn(auth);
            Navigation.NavigateTo(GetReturnUrl(), replace: true);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private string GetReturnUrl()
    {
        var url = ReturnUrl;
        return !string.IsNullOrEmpty(url) && url.StartsWith('/') && !url.StartsWith("//") ? url : "/";
    }

    private sealed class LoginForm
    {
        [Required, EmailAddress]
        public string? Email { get; set; }

        [Required]
        public string? Password { get; set; }
    }
}
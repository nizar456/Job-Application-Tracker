@page "/applications/create"
@attribute [Authorize]
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>New application</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">New application</h1>
    <a class="btn btn-outline-secondary" href="applications">Back to applications</a>
</div>

<ApplicationForm
    Model="_model"
    FormName="application-create"
    Legend="Application details"
    SubmitLabel="Create application"
    SubmitBusyLabel="Creating..."
    OnSubmit="HandleSubmitAsync"
    ServerErrors="_serverErrors"
    ErrorMessage="@_error" />

@code {
    private readonly ApplicationFormModel _model = new();
    private IReadOnlyDictionary<string, string[]>? _serverErrors;
    private string? _error;

    private async Task HandleSubmitAsync(ApplicationFormModel model)
    {
        _serverErrors = null;
        _error = null;
        try
        {
            var created = await Api.PostAsync<JobApplicationResponse>("applications", model.ToRequest());
            Navigation.NavigateTo($"/applications/{created.Id}");
        }
        catch (ApiException ex)
        {
            _serverErrors = ex.Errors is { Count: > 0 } ? ex.Errors : null;
            _error = _serverErrors is null ? ex.Message : null;
        }
    }
}
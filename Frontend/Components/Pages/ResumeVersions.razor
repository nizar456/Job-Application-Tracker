@page "/resume-versions"
@attribute [Authorize]
@inject ApiClient Api

<ResourceManager
    Title="CV versions"
    Noun="CV version"
    NewLabel="New CV version"
    FormName="resume-versions-form"
    LoadItems="LoadAsync"
    SaveItem="SaveAsync"
    DeleteItem="DeleteAsync" />

@code {
    private async Task<IReadOnlyList<ResourceItem>> LoadAsync() =>
        (await Api.GetAsync<List<ResumeVersionResponse>>("resume-versions"))
            .Select(r => new ResourceItem(r.Id, r.Name, null))
            .ToList();

    private async Task SaveAsync(Guid? id, string name, string? secondary)
    {
        if (id is null)
        {
            await Api.PostAsync<ResumeVersionResponse>("resume-versions", new ResumeVersionRequest(name.Trim()));
        }
        else
        {
            await Api.PutAsync($"resume-versions/{id}", new ResumeVersionRequest(name.Trim()));
        }
    }

    private async Task DeleteAsync(Guid id) => await Api.DeleteAsync($"resume-versions/{id}");
}
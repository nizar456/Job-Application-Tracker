@page "/"
@layout AuthLayout

<PageTitle>Job Tracker</PageTitle>

<AuthorizeView>
    <Authorized>
        <RedirectTo Target="/dashboard" />
    </Authorized>
    <NotAuthorized>
        <div class="text-center">
            <h1>Track your job search</h1>
            <p class="page-subtitle mb-4">
                Keep every application, contact, and follow-up in one place with Job Tracker.
            </p>
            <a class="btn btn-primary w-100" href="login">Sign in</a>
            <p class="mt-3 mb-0">
                New here? <a href="register">Create an account</a>
            </p>
        </div>
    </NotAuthorized>
</AuthorizeView>
